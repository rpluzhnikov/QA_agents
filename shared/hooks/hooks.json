{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/kensa-sync.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\kensa-sync.ps1\"",
            "timeout": 30,
            "statusMessage": "kensa-qa: syncing case counters"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/save-memory-stop.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\save-memory-stop.ps1\"",
            "timeout": 10,
            "statusMessage": "kensa-qa: checking memory checkpoint"
          },
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/debug-log.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\debug-log.ps1\"",
            "timeout": 10,
            "statusMessage": "kensa-qa: writing debug log"
          }
        ]
      }
    ]
  }
}
