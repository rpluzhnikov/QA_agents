# Claude Code local overrides (per-user, never committed)
.claude/
.claude-team/

# If kensa-qa hooks ever run in THIS repo (developing the plugin), debug
# output lands here -- not part of the plugin itself.
.tms/debug/

# Codex availability cache (written by hooks/codex-detect.*). Availability is a
# property of the local environment, re-checked every task — never committed.
.tms/.codex-availability
.codex-availability

# Temporary working directories (plan docs, PDF extracts, scratch)
.tmp-*/

# Playwright MCP cache / snapshots (used when regenerating docs/images/*)
.playwright-mcp/

# ISTQB CTFL v4.0.1 syllabus is the source we ground skills against — keep
# locally for reference, do not redistribute through the plugin.
ISTQB_CTFL_Syllabus_v4.0.1.pdf
ISTQB_CTFL_Syllabus_v4.0.1.md

# OS junk
.DS_Store
Thumbs.db
desktop.ini
